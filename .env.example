# Copy to .env and fill in the two required settings. docker compose passes this
# file to the container at run time — nothing is baked into the image, so after
# editing it `docker compose up -d` is enough, no rebuild. `make run` reads the
# same file; on a host without docker, put it at /etc/aksha/.env.
#
# Syntax is docker's --env-file: one KEY=VALUE per line, the value taken
# literally. Do NOT quote values — quotes become part of the value. A # is a
# comment only at the start of a line, so passwords containing # are fine.

# --- Required -----------------------------------------------------------------

# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# postgres://user:password@host:5432/aksha?sslmode=disable
# From inside the container, Postgres on the host is host.docker.internal — and
# it must listen on the docker bridge (listen_addresses, plus a pg_hba.conf line
# for 172.16.0.0/12).
DATABASE_URL=

# --- Who may use the bot ------------------------------------------------------

# Your telegram id, comma-separated for several. Empty means anyone can use it.
ALLOWED_TELEGRAM_IDS=

# --- Everything below already has a default in the image ----------------------
# Uncomment a line only to change it.

# Defaults for new users.
# DEFAULT_TIMEZONE=Asia/Almaty
# DEFAULT_CURRENCY=KZT

# Leave WEBHOOK_URL empty for long polling: the bot calls Telegram itself, needs
# no inbound port, and works behind NAT. Set it to the bot's public HTTPS
# endpoint (nginx with TLS in front, proxying to 127.0.0.1:8080) to receive
# updates by webhook instead.
# WEBHOOK_URL=https://bot.example.com/telegram/webhook
# Verifies updates come from Telegram; letters, digits, _ and - only, up to 256.
# Generated at each start if empty. `openssl rand -hex 32` makes a good one.
# WEBHOOK_SECRET=

# How often statements, reminders and recurring operations are checked. Set to 0
# on a platform that sleeps the instance and trigger runs externally instead:
# POST /tasks/run with SCHEDULER_TOKEN, which also enables that endpoint.
# SCHEDULER_INTERVAL=15m
# SCHEDULER_TOKEN=

# Official NBRK rates, used only for the "≈ in your currency" line in reports.
# Your own operations always use the rate you entered for them.
# FETCH_RATES=true

# Where the HTTP server listens, for /healthz and the webhook.
# HTTP_ADDR=:8080

# Another Bot API server — self-hosted, or a fake in tests. Empty = api.telegram.org.
# TELEGRAM_API_URL=

# DEBUG=false
